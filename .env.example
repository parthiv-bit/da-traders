# ==============================================================================
# DA TRADERS / DYNAMIC — Environment Configuration Template
# ==============================================================================
# This project uses Vite's multi-environment configuration:
#
# - .env.development  -> Used by "npm run dev" and "npm run build:dev" (Firebase: da-traders-dev)
# - .env.production   -> Used by "npm run build:prod" and production deploys (Firebase: da-traders)
#
# Below are the variables required by each environment:

VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID
VITE_FIREBASE_MEASUREMENT_ID=YOUR_MEASUREMENT_ID

# Optional: Email Marketing Webhook / Provider (e.g. Brevo, Mailchimp, Resend)
VITE_NEWSLETTER_WEBHOOK_URL=
